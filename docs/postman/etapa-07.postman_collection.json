{
  "info": {
    "name": "StudyFlow — Etapa 07 — SQLite e relacionamentos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar em ordem. A coleção cria e remove seus próprios registros. A prova real de reinício é executada por npm test e npm run evidence, sem endpoint de desligamento público."
