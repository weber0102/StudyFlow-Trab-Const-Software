  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 — Listar matérias\") { const stamp = Date.now(); pm.collectionVariables.set(\"subjectName\", \"Disciplina Postman \" + stamp); pm.collectionVariables.set(\"taskTitle\", \"Atividade Postman \" + stamp); }"
        ]
      }
    }
  ],
  "item": [
