{
  "info": {
    "name": "StudyFlow — Etapa 06",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD real de tarefas, erros e integração com os serviços de estudo. Executar em ordem; usa um registro próprio e o exclui ao final."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "taskTitle",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 — Listar tarefas\") { pm.collectionVariables.set(\"taskTitle\", \"Apresentação REST \" + Date.now()); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Listar tarefas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
              "pm.test(\"Lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tarefas"
      }
    },
    {
      "name": "02 — Criar tarefa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
              "pm.collectionVariables.set(\"taskId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tarefas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{taskTitle}}\",\n  \"subject\": \"Construção de Software\",\n  \"description\": \"Demonstração do CRUD da Etapa 06.\",\n  \"dueDate\": \"2099-12-10\",\n  \"priority\": \"alta\",\n  \"status\": \"pendente\"\n}",
          "options": {
