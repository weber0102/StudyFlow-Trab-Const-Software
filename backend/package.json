{
  "name": "studyflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST acadêmica do StudyFlow - Etapa 06",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "db:init": "node --env-file-if-exists=.env src/database/cli.js init",
    "db:seed": "node --env-file-if-exists=.env src/database/cli.js seed",
    "db:check": "node --env-file-if-exists=.env src/database/cli.js check",
    "evidence": "node scripts/record-stage07.js"
  },
  "dependencies": { "express": "5.3.0" }
}
